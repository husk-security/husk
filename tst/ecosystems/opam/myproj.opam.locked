opam-version: "2.0"
name: "myproj"
version: "0.1.0"
synopsis: "Locked dependencies for myproj"
depends: [
  "dune" {= "3.10.0"}
  "cmdliner" {= "1.2.0"}
  "ppxlib" {= "0.30.0" & with-test}
  "logs" {build & = "0.7.0"}
  "ocaml" {>= "4.14.0"}
]
pin-depends: [
  ["mylib.dev" "git+https://github.com/example/mylib.git#main"]
]
